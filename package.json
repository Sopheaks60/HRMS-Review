{
  "name": "krompay",
  "version": "1.0.0",
  "private": true,
  "description": "KromPay — enterprise HRMS and Cambodia payroll SaaS",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "prisma": {
    "schema": "packages/prisma/schema.prisma"
  },
  "scripts": {
    "postinstall": "pnpm --filter @krompay/prisma generate",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @krompay/prisma generate && pnpm -r build && node scripts/copy-vercel-output.mjs",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:payroll": "pnpm --filter @krompay/shared test",
    "prisma:generate": "pnpm --filter @krompay/prisma generate",
    "prisma:migrate": "pnpm --filter @krompay/prisma migrate:dev",
    "prisma:seed": "pnpm --filter @krompay/prisma seed",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}

NODE_ENV=development
APP_NAME=KromPay
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Database
DATABASE_URL=postgresql://krompay:krompay@localhost:5432/krompay?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Local development key only. Generate a unique random key for every environment; never reuse this example in production.
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=krompay
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=KromPay <noreply@krompay.local>
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true
EMAIL_MESSAGE_DOMAIN=krompay.local

# Push (FCM)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ZKTeco ADMS gateway signs timestamp + raw body; do not expose device endpoints directly.
BIOMETRIC_WEBHOOK_SECRET=change-me-zkteco

# Face match and liveness provider (server-to-server; must support action=verify)
FACE_VERIFICATION_URL=
FACE_VERIFICATION_TOKEN=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
